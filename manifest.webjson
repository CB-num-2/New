{
  "name": "Fixed Offline PWA",
  "short_name": "FixedPWA",
  "start_url": "index.html",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  
  "offline": true,
  "cache_assets": [
    "index.html",
    "manifest.webjson"
  ],
  
  "icons": [
    { "src": "https://placeholder.com", "sizes": "192x192", "type": "image/png" },
    { "src": "https://placeholder.com", "sizes": "512x512", "type": "image/png" }
  ]
}
